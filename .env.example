# ECUView - Environment Variables
# Copy this file to .env and modify as needed

# Security - CHANGE THIS IN PRODUCTION!
SECRET_KEY=ecuview-change-this-secret-key-in-production

# Database
DATABASE_URL=sqlite:///./data/ecuview.db

# File uploads
UPLOAD_DIR=/app/data/uploads
# Single file max (bytes) — default 50MB
MAX_FILE_SIZE=52428800
# Per-user total storage (bytes) — default 100MB
MAX_USER_STORAGE=104857600
